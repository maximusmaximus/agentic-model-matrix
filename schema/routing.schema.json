{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic SDLC Model Routing Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "week_id",
    "generated_at",
    "governance",
    "app_build_policy",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "week_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "generated_at": {
      "type": "string"
    },
    "governance": {
      "type": "object",
      "required": ["requires_pr_merge", "cadence"],
      "properties": {
        "requires_pr_merge": { "const": true },
        "cadence": { "const": "weekly" },
        "branch_prefix": { "type": "string" }
      }
    },
    "app_build_policy": {
      "type": "object",
      "required": ["stage_id", "provider", "model_family"],
      "properties": {
        "stage_id": { "const": "app_build" },
        "provider": { "const": "antigravity" },
        "model_family": { "const": "gemini" }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "title",
          "primary_provider",
          "primary_model",
          "effort",
          "cli_mode",
          "fallback_chain",
          "selection_criteria",
          "best_practices"
        ],
        "properties": {
          "id": {
            "enum": [
              "triage",
              "research",
              "consensus_specs",
              "architecture",
              "app_build",
              "qa_deploy"
            ]
          },
          "order": { "type": "integer", "minimum": 1, "maximum": 6 },
          "title": { "type": "string", "minLength": 3 },
          "primary_provider": { "type": "string", "minLength": 2 },
          "model_family": { "type": "string" },
          "primary_model": { "type": "string", "minLength": 3 },
          "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
          "cli_mode": { "enum": ["plan", "accept-edits", "auto"] },
          "fallback_chain": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 3 }
          },
          "selection_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "best_practices": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          }
        }
      }
    }
  }
}
